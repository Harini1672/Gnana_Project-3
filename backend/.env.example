# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Google Gemini  (answer generation + embeddings) ───────────────────────────
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Embedding model — outputs 3072-dim vectors; Pinecone index must match.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=whatsapp-chatbot

# ── WasenderAPI  (WhatsApp messaging) ─────────────────────────────────────────
# Dashboard: https://app.wasenderapi.com
WASENDER_API_KEY=your-wasender-api-key
WASENDER_SESSION_NAME=Gowthami
WASENDER_BASE_URL=https://www.wasenderapi.com
# Must match the Webhook Secret set in the Wasender dashboard → Session → Webhooks.
WASENDER_WEBHOOK_SECRET=your-webhook-secret
